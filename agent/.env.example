# ============================================================
# VoxAI Agent 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- LiveKit 服务器连接 ---
# LiveKit 服务器 URL（如 wss://your-project.livekit.cloud）
LIVEKIT_URL=wss://your-livekit-server
# LiveKit API Key
LIVEKIT_API_KEY=your-api-key
# LiveKit API Secret
LIVEKIT_API_SECRET=your-api-secret

# --- STT 语音转文字 ---
# 服务商: deepgram / openai
STT_PROVIDER=deepgram
# Deepgram 配置
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=multi

# --- LLM 大语言模型 ---
# 服务商: openai / ollama
LLM_PROVIDER=openai
# OpenAI 配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_LLM_MODEL=gpt-4o-mini
# 可选：OpenAI 兼容 API 的 base URL（如 Azure、代理）
# OPENAI_BASE_URL=https://api.openai.com/v1
# Ollama 配置（本地部署）
# OLLAMA_MODEL=qwen2.5:latest
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- TTS 文字转语音 ---
# 服务商: cartesia / deepgram / openai
TTS_PROVIDER=cartesia
# Cartesia 配置
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_TTS_MODEL=sonic-2
CARTESIA_VOICE_ID=f9836c6e-2bd7-4a12-aa56-69c6f692e4b4
# Deepgram TTS 配置
# DEEPGRAM_TTS_MODEL=aura-2-asteria-en
# OpenAI TTS 配置
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy

# --- Agent 人设 ---
# 自定义 Agent 的系统提示词
# AGENT_SYSTEM_PROMPT=你是一个名叫 VoxAI 的智能语音助手...
